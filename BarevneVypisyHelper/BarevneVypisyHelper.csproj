<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>BarevneVypisyHelper</PackageId>
    <Title>BarevneVypisyHelper</Title>
    <PackageProjectUrl>https://github.com/AdriansRepos/BarevneVypisyHelper</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Company>AdriansRepos</Company>
    <Product>BarevneVypisyHelper</Product>
    <Authors>AdriansRepos</Authors>
    <Description>Knihovna pro barevné výpisy zpráv a hlášení v konzolových aplikacích.</Description>
    <RepositoryUrl>https://github.com/AdriansRepos/BarevneVypisyHelper</RepositoryUrl>
   
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
